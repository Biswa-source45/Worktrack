# Copy to .env and fill in. Never commit .env.
# One file for every app: backend reads it directly, web and mobile scripts load it with dotenv-cli.

APP_ENV=development            # development | test | production

# --- Backend: 127.0.0.1, not localhost (on Windows localhost tries IPv6 first and is slow) (infra/docker-compose.dev.yml defaults; Redis is on host port 6380 because Memurai uses 6379)
DATABASE_URL=postgresql+asyncpg://worktrack:worktrack@127.0.0.1:5432/worktrack
TEST_DATABASE_URL=postgresql+asyncpg://worktrack:worktrack@127.0.0.1:5432/worktrack_test
REDIS_URL=redis://127.0.0.1:6380/0
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=worktrack
S3_SECRET_KEY=worktrack-dev-secret
S3_BUCKET=worktrack
S3_REGION=us-east-1
CORS_ORIGINS=http://localhost:3000
# Signs access tokens (min 32 chars). Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The backend refuses to start in production with a short value or this placeholder.
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
# Encrypts face embeddings (AES-256): base64 of exactly 32 random bytes. Generate one:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing or changing it makes every enrolled face unreadable (re-enrollment needed).
# The backend refuses to start in production with a bad value or this placeholder.
FACE_ENCRYPTION_KEY=ZGV2LW9ubHktZmFjZS1rZXktY2hhbmdlLW1lLTAwMDA=
# Development-only. The backend refuses to start with this on when APP_ENV=production.
ALLOW_MOCK_LOCATION=false
# Optional: address search used when placing a branch or home pin (default: public Nominatim).
# GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- ngrok (phones reach the backend only through this domain)
NGROK_DOMAIN=your-domain.ngrok-free.dev

# --- Web (Next.js inlines NEXT_PUBLIC_* at build time)
# http://localhost:8000 for the browser on this PC, or https://${NGROK_DOMAIN} to go through the tunnel.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only: where the web portal's server reaches the backend (defaults to NEXT_PUBLIC_API_URL).
# API_URL=http://127.0.0.1:8000
# The web app sends ngrok-skip-browser-warning only when this is "development" (mirror APP_ENV).
NEXT_PUBLIC_APP_ENV=development
# Optional: map tiles for the branch and home pins (default: public OpenStreetMap tiles).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# --- Mobile (dotenv-cli expands ${NGROK_DOMAIN}; Metro inlines EXPO_PUBLIC_* at bundle time)
EXPO_PUBLIC_API_URL=https://${NGROK_DOMAIN}
EXPO_PUBLIC_APP_ENV=development

# --- Mobile dev build (read by apps/mobile/app.config.ts at build time; never committed)
# Google Maps SDK for Android key, restricted to com.biswabhusan.worktrack + the EAS dev keystore SHA-1.
# For cloud builds set the same name as an EAS environment variable.
# GOOGLE_MAPS_ANDROID_API_KEY=
# Firebase file for push (M8). On EAS, upload google-services.json as the file variable GOOGLE_SERVICES_JSON.
# GOOGLE_SERVICES_JSON=./google-services.json
