{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "dotenv -e ../../.env -- expo start --dev-client",
    "start:go": "dotenv -e ../../.env -- expo start --go",
